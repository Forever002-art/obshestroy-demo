BOT_TOKEN=
ADMIN_IDS=
DEMO_MODE=true

# Для локального запуска по умолчанию используется SQLite.
# Для вебхука укажите строку подключения к PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTO_MIGRATE=true

# Для вебхука и расписания нужны два разных секрета.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

TIMEZONE=Europe/Moscow
TRIAL_DAYS=60
SUPPORT_USERNAME=
DADATA_TOKEN=
